# Copia este archivo como .env y completa los valores.
# Sin estos valores, la app funciona en modo simulado.

# anthropic | openai | groq | gemini | openai-compatible
LLM_PROVIDER=
LLM_API_KEY=
# Nombre exacto del modelo del proveedor elegido
LLM_MODEL=
# Solo para openai-compatible
LLM_BASE_URL=

# Opcional: guardar tareas en Upstash Redis (sin esto, viven en memoria)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: guardar los archivos originales en Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
